# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/

# PyInstaller
#  通常这些文件夹是打包过程生成的临时文件
build/
dist/
# spec 是 PyInstaller 每次构建都会重写的产物，不纳入版本管理
*.spec

# Project Specific
bin/
ffmpeg/
*.json
!requirements.txt
!package.json
# 配置模板需要入库 (上面的 *.json 会把它一起忽略)
!config.example.json
# 滤镜效果说明需要入库
!config/lut_descriptions.json
# 忽略运行时生成的配置
dji_luter_config.json
dji_export_config.json
# 忽略素材和导出目录下的所有文件 (不推送到 GitHub)
RAW/
EXPORT/

# 忽略打包生成的压缩包和工具
*.zip
upx.exe
release_*/
DJI_Batch_LUTer_*/
# build.py 打包过程中的临时过渡目录（中断/失败时可能残留）
_build_dist_*/
_dist_old_*/

# 本地 AI 助手会话记忆/日志目录，不进入仓库
.workbuddy/

# Log files
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
.trae/
*.swp
*.swo
